<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.ahdyahmed</groupId>
    <artifactId>eventhub-booking-system</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>eventhub-booking-system</name>
    <description>
        Production-grade event/ticket booking and order-processing system built with Spring Boot.
        Project 3 of a 3-project backend portfolio.
    </description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- Core web + persistence -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Auth (Day 16): JWT, reusing Spring Security rather than hand-rolling filter/session logic -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!--
            jjwt, not Nimbus or a hand-rolled HMAC implementation: a small,
            purpose-built API (Jwts.builder()/.parser()) for exactly the
            "sign a compact token, verify it later" scope this project
            needs, versus Nimbus's broader (and heavier) OAuth2/OIDC-oriented
            surface. Three artifacts, not one - jjwt-api is the compile-time
            surface (Jwts, Claims); jjwt-impl and jjwt-jackson are runtime
            implementation details (the actual signing/parsing logic, and
            JSON (de)serialization via Jackson, which this project already
            depends on transitively via spring-boot-starter-web) that
            application code never references directly.
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <!--
            Structured logging (Day 17): a Logback encoder that writes each
            log event as one JSON object per line, and - via its
            StructuredArguments API - turns log.info("...", kv("bookingId", 5))
            into a real queryable "bookingId": 5 field instead of text to
            regex over.

            Why this library rather than Spring Boot's own structured
            logging: that feature (logging.structured.format.console) only
            exists from Spring Boot 3.4; this project is on 3.3.4, so the
            standard Logback-encoder route the roadmap names is the right
            tool here. Not managed by Boot's dependency BOM, hence the
            explicit version. 8.x is the line built against Logback 1.5,
            which is what Boot 3.3 ships.
        -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>8.0</version>
        </dependency>

        <!-- Caching (Day 8): cache abstraction + Redis as the backing store -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Messaging (Day 11): event-driven flow, booking -> payment -> notification -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- Database -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Schema migrations -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Boilerplate reduction -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Day 15: EventChainIT needs a real Kafka broker, not a mock -
            proving retry/DLT behavior means proving Spring Kafka's actual
            error-handling machinery against a real broker, which no amount
            of mocking substitutes for. Redis (Day 10, RedisCacheIT) got by
            with a plain GenericContainer - a single port, a trivial
            protocol. Kafka's advertised-listener / broker-vs-client
            addressing is real complexity a GenericContainer would mean
            hand-rolling; testcontainers' purpose-built module exists
            specifically to hide that, which is the justification for
            reaching for a dedicated module here where Redis didn't need one.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Day 15: KafkaTestUtils, for reading the dead-letter topic back out in EventChainIT. -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Day 15: EventChainIT's assertions are about state that becomes
            true asynchronously, on Kafka consumer threads this test doesn't
            control - "the booking eventually reaches CONFIRMED," not "the
            booking is CONFIRMED right after this method returns." A
            Thread.sleep(n) guess is either flaky (n too small) or slow on
            every run (n padded for safety); Awaitility's poll-until-true
            expresses the actual condition being waited for instead of a
            guessed duration.
        -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <version>4.2.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>1.20.1</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <finalName>eventhub-booking-system</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!--
                Surefire (bound to `mvn test`) only picks up *Test/*Tests by
                its default include pattern - it deliberately never runs
                *IT classes. Failsafe (bound to `mvn verify`) is the
                complementary plugin that does, via its own default pattern.
                This split is intentional, not incidental: BookingConcurrencyIT
                needs Docker and takes several seconds, so it shouldn't run
                on every `mvn test` the way the fast unit tests do.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
