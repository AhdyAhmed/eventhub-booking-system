        <mxCell id="subtitle" value="Synchronous HTTP path — PostgreSQL is authoritative; Redis is an acceleration layer" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="370" y="60" width="660" height="30" as="geometry"/></mxCell>
        <mxCell id="client" value="HTTP client&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Bearer JWT + optional X-Correlation-Id&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="180" height="70" as="geometry"/></mxCell>
        <mxCell id="correlation" value="CorrelationIdFilter&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;validate/generate ID; response header; MDC&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="270" y="160" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="security" value="Spring Security&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;JWT authentication + route policy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="510" y="160" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="controller" value="REST controllers&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;DTO validation + ownership boundary&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="750" y="160" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="service" value="Feature services&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;business rules + transactions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="990" y="160" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="repo" value="Spring Data repositories" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="990" y="330" width="190" height="60" as="geometry"/></mxCell>
        <mxCell id="postgres" value="PostgreSQL 16&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Flyway schema; optimistic versions&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="990" y="470" width="190" height="90" as="geometry"/></mxCell>
        <mxCell id="cache" value="Spring Cache abstraction&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;cache-aside + targeted eviction&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="750" y="330" width="190" height="60" as="geometry"/></mxCell>
        <mxCell id="redis" value="Redis 7&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;events / event-search / seat-availability&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="750" y="470" width="190" height="90" as="geometry"/></mxCell>
        <mxCell id="domain-event" value="Application event&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;booking saved inside transaction&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="510" y="330" width="190" height="60" as="geometry"/></mxCell>
        <mxCell id="after-commit" value="AFTER_COMMIT publisher&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Kafka send starts only after DB commit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="510" y="470" width="190" height="90" as="geometry"/></mxCell>
        <mxCell id="kafka" value="Kafka&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;asynchronous path continues on page 2&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="510" y="630" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="public-note" value="Public: GET events/venues, auth register/login, health probes&lt;br&gt;Protected: all writes, bookings, user data, info/metrics" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="330" width="330" height="100" as="geometry"/></mxCell>
        <mxCell id="error-note" value="GlobalExceptionHandler returns one ErrorResponse shape; correlation ID appears in the response header, error body, structured logs, and Kafka headers." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="480" width="330" height="100" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="client" target="correlation"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="correlation" target="security"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="authorized" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="security" target="controller"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="controller" target="service"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="authoritative data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="service" target="repo"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="repo" target="postgres"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="read / evict" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="service" target="cache"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="cache" target="redis"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="booking created" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="service" target="domain-event"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="transaction committed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="domain-event" target="after-commit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="key = bookingId" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="after-commit" target="kafka"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="event-flow" name="2 - Event flow">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="EventHub asynchronous event flow" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="450" y="20" width="500" height="40" as="geometry"/></mxCell>
        <mxCell id="booking-service" value="BookingServiceImpl&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;reserve seats; save PENDING booking&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="db" value="PostgreSQL&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;transaction commit&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="210" height="80" as="geometry"/></mxCell>
        <mxCell id="publisher" value="BookingConfirmedEventPublisher&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;transaction phase: AFTER_COMMIT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="150" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="booking-topic" value="booking-confirmed-events&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;3 partitions; key = bookingId&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="150" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="payment-consumer" value="PaymentConsumer&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;group: payment-service&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="860" y="100" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="notification" value="NotificationListener&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;group: notification-service; mock email&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="860" y="240" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="mock-payment" value="MockPaymentService&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;deterministic threshold&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1130" y="100" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="payment-topic" value="payment-processed-events&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;3 partitions; key = bookingId&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1130" y="330" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="settlement" value="PaymentProcessedListener&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;group: booking-service&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="860" y="470" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="state" value="Booking state machine&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;CONFIRMED / FAILED; BOOKED / AVAILABLE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="470" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="redis" value="Redis eviction&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;seat-availability(eventId)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="620" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="booking-dlt" value="booking-confirmed-events.DLT" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="330" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="payment-dlt" value="payment-processed-events.DLT" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1130" y="620" width="210" height="60" as="geometry"/></mxCell>
        <mxCell id="retry-note" value="Shared listener policy: exponential retry (500 ms start, 5 s cap, 10 s elapsed) then same-partition DLT. X-Correlation-Id is copied into Kafka headers and restored into MDC for each consumer." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="420" height="130" as="geometry"/></mxCell>
        <mxCell id="e1" value="save" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="booking-service" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="Spring application event" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="booking-service" target="publisher"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="after commit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="db" target="publisher"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="publish" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="publisher" target="booking-topic"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="fan-out by group" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="booking-topic" target="payment-consumer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="fan-out by group" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="booking-topic" target="notification"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="charge" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="payment-consumer" target="mock-payment"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="SUCCEEDED or DECLINED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="mock-payment" target="payment-topic"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="payment-topic" target="settlement"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="idempotent transition" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="settlement" target="state"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="persist" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="state" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="evict" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="state" target="redis"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="retries exhausted" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#b85450;endArrow=block;endFill=1;" edge="1" parent="1" source="booking-topic" target="booking-dlt"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="retries exhausted" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#b85450;endArrow=block;endFill=1;" edge="1" parent="1" source="payment-topic" target="payment-dlt"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="cache-layer" name="3 - Cache layer">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Redis cache-aside and invalidation" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="450" y="20" width="500" height="40" as="geometry"/></mxCell>
        <mxCell id="read" value="Read request&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;event detail/search or seat availability&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="130" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="spring-cache" value="Spring Cache proxy&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;stable key per query/resource&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="130" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="redis" value="Redis 7&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;JSON values; nulls disabled; statistics on&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610" y="120" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="response" value="HTTP 200 response" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1110" y="130" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="service" value="Service method executes&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;only on cache miss&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610" y="320" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="postgres" value="PostgreSQL&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;source of truth&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="890" y="310" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="events-ttl" value="events&lt;br&gt;&lt;b&gt;TTL 5 minutes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;individual event details&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="50" y="300" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="search-ttl" value="event-search&lt;br&gt;&lt;b&gt;TTL 1 minute&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;filter/page/sort results&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="50" y="420" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="seat-ttl" value="seat-availability&lt;br&gt;&lt;b&gt;TTL 30 seconds&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;event + optional status&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="50" y="540" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="writes" value="State-changing operations&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;event/seat writes; booking; cancellation; payment result&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="510" width="250" height="80" as="geometry"/></mxCell>
        <mxCell id="evictor" value="Targeted eviction&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;affected event/search/seat keys&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="510" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="fail-note" value="Redis is never authoritative. If the cache cannot answer, the application logs the cache failure and uses the service/database path; later successful reads can repopulate the key." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="950" y="500" width="360" height="110" as="geometry"/></mxCell>
        <mxCell id="legend" value="TTL limits staleness; write-side eviction provides immediate correctness during normal operation. Actuator cache.gets metrics expose hit/miss behavior for the Day 21 load test." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="650" width="540" height="80" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="read" target="spring-cache"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="lookup" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="spring-cache" target="redis"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="HIT: deserialize" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="redis" target="response"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="MISS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="redis" target="service"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="query" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="service" target="postgres"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="result" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="postgres" target="response"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="populate with TTL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="service" target="redis"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="after state change" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="writes" target="evictor"><mxGeometry relative="1" as="geometry"/></mxCell>
