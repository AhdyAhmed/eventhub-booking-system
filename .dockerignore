# Day 18: what must NOT be sent to the Docker daemon as build context.
# The build stage compiles from pom.xml + src/ only; everything else is
# either rebuilt inside the image or irrelevant to it. A smaller context
# also means a faster `docker build` start, and keeps local-only files
# (a stray .env, IDE state) from ever being copied into an image layer.

# Build output - rebuilt inside the image; a stale host target/ must never leak in
target/

# Version control
.git
.gitignore
.gitattributes

# IDEs / editors
.idea/
*.iml
.vscode/
.classpath
.project
.settings/

# OS junk
.DS_Store
Thumbs.db

# Local secrets / env overrides
.env
.env.*

# Not needed to build or run the app
*.md
docker-compose*.yml
Dockerfile
.dockerignore
*.log
logs/
