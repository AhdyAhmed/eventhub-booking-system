# Copy this file to .env to customize the local Docker Compose stack.
COMPOSE_PROJECT_NAME=eventhub

APP_IMAGE=eventhub-booking-system:dev
APP_MEMORY_LIMIT=1g
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=

DB_NAME=eventhub_db
DB_USER=eventhub_user
DB_PASSWORD=eventhub_pass
DB_PORT=5433

REDIS_PORT=6380
KAFKA_HOST_PORT=9094

# Use a secret manager or a long random value outside local development.
JWT_SECRET=replace-this-local-demo-secret-with-at-least-32-random-bytes
JWT_EXPIRATION_MS=3600000

PAYMENT_MOCK_DECLINE_THRESHOLD=1000.00
